Imports System.Globalization
Imports System.Text.RegularExpressions

''' <summary>
''' Checks a processor against Microsoft's list of processors supported by Windows 11. The list is a data file
''' embedded in the executable (windows11-supported-processors.txt, generated by docs\update-supported-processors.ps1),
''' so no internet connection is needed when scanning.
''' Intel's list is by generation ("10th Generation Core i7 Processors") and AMD's by model, and Microsoft states
''' that newer generations are supported even if the list does not name them yet; the answer says which case applies.
''' </summary>
Friend Module ProcessorSupport
    Private Const ResourceName As String = "windows11-supported-processors.txt"
    Private Const MinimumIntelGeneration As Integer = 8
    Private Const MinimumAmdFirstDigit As Integer = 3 'Ryzen 3000 series and newer

    Friend Enum VerdictEnum
        ''' <summary>The processor is in Microsoft's list.</summary>
        Supported
        ''' <summary>Not named in the list, but newer than everything it covers, which Microsoft treats as supported.</summary>
        SupportedByGeneration
        NotSupported
        ''' <summary>The processor could not be classified (Xeon, Celeron, Pentium, virtual or unusual processors).</summary>
        Unknown
    End Enum

    Friend Class Result
        Public ReadOnly Property Verdict As VerdictEnum
        Public ReadOnly Property Detail As String

        Public Sub New(ByVal pVerdict As VerdictEnum, ByVal pDetail As String)
            Verdict = pVerdict
            Detail = pDetail
        End Sub
    End Class

    Private _Loaded As Boolean
    Private _ListAvailable As Boolean
    Private ReadOnly _IntelGenerations As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase) 'for example "10|i7"
    Private ReadOnly _IntelXSeries As New HashSet(Of Integer) 'for example 7000 (Core 7000X)
    Private ReadOnly _AmdModels As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase) 'for example "ryzen 7|7700"
    Private _NewestIntelGeneration As Integer

    ''' <summary>Classifies a processor from its name (Win32_Processor.Name).</summary>
    Friend Function Check(ByVal pProcessorName As String) As Result
        EnsureLoaded()
        If Not _ListAvailable Then Return New Result(VerdictEnum.Unknown, "Microsoft's list of supported processors is not available in this build")

        Dim oName As String = If(pProcessorName, String.Empty).Trim()
        If oName.IndexOf("Intel", StringComparison.OrdinalIgnoreCase) >= 0 Then Return CheckIntel(oName)
        If oName.IndexOf("AMD", StringComparison.OrdinalIgnoreCase) >= 0 OrElse oName.IndexOf("Ryzen", StringComparison.OrdinalIgnoreCase) >= 0 Then Return CheckAmd(oName)
        Return New Result(VerdictEnum.Unknown, "Not checked: '" + oName + "' is not an Intel or AMD processor")
    End Function

#Region "Intel"
    Private Function CheckIntel(ByVal pName As String) As Result
        'Core i3/i5/i7/i9 with a model number: i7-10510U, i5-8250U, i7-1165G7, i9-7900X
        Dim oCore As Match = Regex.Match(pName, "\bi([3579])-(\d{3,5})([A-Za-z0-9]*)")
        If oCore.Success Then
            Dim oBrand As String = "i" + oCore.Groups(1).Value
            Dim oNumber As String = oCore.Groups(2).Value
            Dim oModel As String = oBrand + "-" + oNumber + oCore.Groups(3).Value
            Dim oGeneration As Integer = IntelGeneration(oNumber)

            If oGeneration >= MinimumIntelGeneration Then
                If _IntelGenerations.Contains(oGeneration.ToString(CultureInfo.InvariantCulture) + "|" + oBrand) Then
                    Return New Result(VerdictEnum.Supported, oModel + ": " + Ordinal(oGeneration) + " generation Core " + oBrand + " is in Microsoft's list")
                End If
                If oGeneration > _NewestIntelGeneration Then
                    Return New Result(VerdictEnum.SupportedByGeneration, oModel + ": " + Ordinal(oGeneration) + " generation is newer than Microsoft's list (up to " + Ordinal(_NewestIntelGeneration) + "); newer generations are treated as supported")
                End If
            End If

            'Core X-series (7000X, 9000X, 10000X) are listed although they come from older generations
            If oCore.Groups(3).Value.EndsWith("X", StringComparison.OrdinalIgnoreCase) AndAlso oNumber.Length >= 4 Then
                Dim oSeries As Integer = Integer.Parse(oNumber.Substring(0, oNumber.Length - 3), CultureInfo.InvariantCulture) * 1000
                If _IntelXSeries.Contains(oSeries) Then Return New Result(VerdictEnum.Supported, oModel + ": Core " + oSeries.ToString(CultureInfo.InvariantCulture) + "X series is in Microsoft's list")
            End If

            Return New Result(VerdictEnum.NotSupported, oModel + ": " + Ordinal(oGeneration) + " generation; Windows 11 needs the 8th generation or newer (or a Core X-series in the list)")
        End If

        'Core Ultra and the new "Core 5 / Core 7" names (Series 1 and later)
        If Regex.IsMatch(pName, "Core\(TM\)\s+(?:Ultra\s+)?[3579]\s+\d{3}") Then
            Return New Result(VerdictEnum.SupportedByGeneration, pName + ": Core Series 1 or newer, treated as supported by Microsoft")
        End If

        'First generation names without a dash (Core i5 CPU 750) and Core 2
        If Regex.IsMatch(pName, "\bi[3579]\s+CPU\s+\d{3}\b") OrElse Regex.IsMatch(pName, "Core\(TM\)\s*2") OrElse pName.IndexOf("Atom", StringComparison.OrdinalIgnoreCase) >= 0 Then
            Return New Result(VerdictEnum.NotSupported, pName + " is not in Microsoft's list (too old, or an Atom)")
        End If

        'Hardware that is clearly older than everything in the list, whatever the exact model
        Dim oOld As String = OldIntelReason(pName)
        If oOld.Length > 0 Then Return New Result(VerdictEnum.NotSupported, pName.Trim() + " is not supported: " + oOld)

        'The rest of Xeon, Celeron and Pentium is listed by series that are not worth guessing from the name
        Return New Result(VerdictEnum.Unknown, "Not checked: compare " + pName.Trim() + " with Microsoft's list of supported Intel processors by hand")
    End Function

    ''' <summary>
    ''' Reasons an Intel processor is certainly too old, without needing the list: Pentium II/III/4/D/M, Celeron M/D,
    ''' Bay Trail and Braswell Celeron/Pentium (N1xxx-N3xxx, J1xxx-J3xxx), Celeron/Pentium G with a model number
    ''' below 4000, and the Xeons made before the Scalable family (E7340, X5650, E5-2680 v4, "Xeon(TM)").
    ''' Empty when none applies, which leaves the processor unclassified.
    ''' </summary>
    Private Function OldIntelReason(ByVal pName As String) As String
        If Regex.IsMatch(pName, "Pentium\(R\)\s*(?:II|III|4|D|M|Pro|Dual-Core)\b|Pentium\s+(?:II|III|4|D|M|Dual-Core)\b|Celeron\(R\)\s+(?:M|D)\b|Celeron\(R\)\s+CPU\s+\d\.\d+\s*GHz", RegexOptions.IgnoreCase) Then
            Return "Pentium/Celeron from before the Core family"
        End If

        Dim oLowEnd As Match = Regex.Match(pName, "(?:Celeron|Pentium)[^@]*?\b([NJG])(\d)\d{2,3}\b", RegexOptions.IgnoreCase)
        Dim oSandy As Boolean = Regex.IsMatch(pName, "(?:Celeron|Pentium)[^@]*?\bG\d{3}\b", RegexOptions.IgnoreCase)
        If oSandy Then
            Return "its three-digit G series (Sandy Bridge) is older than the Celeron/Pentium series in Microsoft's list (4000 and newer)"
        End If
        If oLowEnd.Success AndAlso Integer.Parse(oLowEnd.Groups(2).Value, CultureInfo.InvariantCulture) < 4 Then
            Return "its " + oLowEnd.Groups(1).Value.ToUpperInvariant() + oLowEnd.Groups(2).Value + "000 series is older than the Celeron/Pentium series in Microsoft's list (4000 and newer)"
        End If

        If Regex.IsMatch(pName, "Xeon\(TM\)", RegexOptions.IgnoreCase) OrElse Regex.IsMatch(pName, "Xeon\(R\)\s+CPU\s+(?:[EXLW]\d{4}\b|E[357]-\d{4})", RegexOptions.IgnoreCase) Then
            Return "this Xeon is older than the Scalable and E-2100/W-1200 families in Microsoft's list"
        End If

        Return String.Empty
    End Function

    ''' <summary>
    ''' Generation from a Core model number: 3 digits = 1st, 4 digits starting with 1 = the first two digits
    ''' (1165G7 is 11th), other 4 digits = the first digit (8250U is 8th), 5 digits = the first two (10510U is 10th).
    ''' </summary>
    Private Function IntelGeneration(ByVal pNumber As String) As Integer
        Select Case pNumber.Length
            Case 3 : Return 1
            Case 4 : Return Integer.Parse(If(pNumber.StartsWith("1", StringComparison.Ordinal), pNumber.Substring(0, 2), pNumber.Substring(0, 1)), CultureInfo.InvariantCulture)
            Case Else : Return Integer.Parse(pNumber.Substring(0, 2), CultureInfo.InvariantCulture)
        End Select
    End Function

    Private Function Ordinal(ByVal pNumber As Integer) As String
        Dim oSuffix As String = "th"
        If pNumber Mod 100 < 11 OrElse pNumber Mod 100 > 13 Then
            Select Case pNumber Mod 10
                Case 1 : oSuffix = "st"
                Case 2 : oSuffix = "nd"
                Case 3 : oSuffix = "rd"
            End Select
        End If
        Return pNumber.ToString(CultureInfo.InvariantCulture) + oSuffix
    End Function
#End Region

#Region "AMD"
    Private Function CheckAmd(ByVal pName As String) As Result
        'Ryzen 3 / 5 / 7 / 9 [PRO] <model>, Ryzen Threadripper PRO <model>
        Dim oRyzen As Match = Regex.Match(pName, "Ryzen\s+(Threadripper\s+PRO|[3579])(?:\s+(PRO))?\s+([0-9][0-9A-Za-z]*)", RegexOptions.IgnoreCase)
        If oRyzen.Success Then
            Dim oBrand As String = "ryzen " + Regex.Replace(oRyzen.Groups(1).Value, "\s+", " ").ToLowerInvariant()
            If oRyzen.Groups(2).Success Then oBrand += " pro"
            Dim oModel As String = oRyzen.Groups(3).Value.ToLowerInvariant()
            Dim oDisplay As String = "Ryzen " + oRyzen.Groups(1).Value + If(oRyzen.Groups(2).Success, " PRO", String.Empty) + " " + oRyzen.Groups(3).Value

            If _AmdModels.Contains(oBrand + "|" + oModel) Then Return New Result(VerdictEnum.Supported, oDisplay + " is in Microsoft's list")

            If oBrand.StartsWith("ryzen threadripper", StringComparison.Ordinal) Then
                Return New Result(VerdictEnum.Unknown, "Not checked: " + oDisplay + " is not in Microsoft's list; check it by hand")
            End If

            Dim oDigit As Integer = Integer.Parse(oModel.Substring(0, 1), CultureInfo.InvariantCulture)
            If oDigit >= MinimumAmdFirstDigit Then
                Return New Result(VerdictEnum.SupportedByGeneration, oDisplay + " is not named in Microsoft's list, but it is a Ryzen " + oDigit.ToString(CultureInfo.InvariantCulture) + "000 series or newer, which Windows 11 supports")
            End If
            Return New Result(VerdictEnum.NotSupported, oDisplay + " is not in Microsoft's list (Ryzen 1000 and 2000 mobile/first-generation parts are not supported)")
        End If

        'Everything AMD made before Ryzen (Phenom, FX, Sempron, Opteron, Athlon II / 64 / X2 / X4) is older than Windows 11 supports
        If Regex.IsMatch(pName, "Phenom|Sempron|Opteron|\bFX\b|FX\(tm\)|Athlon\(tm\)\s*(?:II|64|X[0-9])|Athlon\s+(?:II|64|X[0-9])", RegexOptions.IgnoreCase) Then
            Return New Result(VerdictEnum.NotSupported, pName + " is a processor from before Ryzen, which Windows 11 does not support")
        End If

        'Ryzen AI (2024 and later) is newer than the list
        If Regex.IsMatch(pName, "Ryzen\s+AI", RegexOptions.IgnoreCase) Then Return New Result(VerdictEnum.SupportedByGeneration, pName + ": Ryzen AI is newer than Microsoft's list")

        'Athlon: the list names them as "Silver 3050U", "Gold 3150G", "3000G"
        Dim oAthlon As Match = Regex.Match(pName, "Athlon\s+(?:\(tm\)\s+)?([A-Za-z0-9 ]+?)(?:\s+with\b|\s+Processor|\s*$)", RegexOptions.IgnoreCase)
        If oAthlon.Success Then
            Dim oModel As String = oAthlon.Groups(1).Value.Trim().ToLowerInvariant()
            Dim oLast As String = oModel.Substring(oModel.LastIndexOf(" "c) + 1)
            If _AmdModels.Contains("athlon|" + oModel) OrElse _AmdModels.Contains("athlon|" + oLast) Then Return New Result(VerdictEnum.Supported, "Athlon " + oAthlon.Groups(1).Value.Trim() + " is in Microsoft's list")
            Return New Result(VerdictEnum.NotSupported, "Athlon " + oAthlon.Groups(1).Value.Trim() + " is not in Microsoft's list")
        End If

        Dim oEpyc As Match = Regex.Match(pName, "EPYC\s+([0-9][0-9A-Za-z]*)", RegexOptions.IgnoreCase)
        If oEpyc.Success Then
            If _AmdModels.Contains("epyc|" + oEpyc.Groups(1).Value.ToLowerInvariant()) Then Return New Result(VerdictEnum.Supported, "EPYC " + oEpyc.Groups(1).Value + " is in Microsoft's list")
            Return New Result(VerdictEnum.Unknown, "Not checked: EPYC " + oEpyc.Groups(1).Value + " is not in Microsoft's list; check it by hand")
        End If

        Return New Result(VerdictEnum.Unknown, "Not checked: could not recognize the AMD processor '" + pName + "'")
    End Function
#End Region

#Region "Data file"
    Private Sub EnsureLoaded()
        If _Loaded Then Exit Sub
        _Loaded = True

        Try
            Using oStream As IO.Stream = GetType(ProcessorSupport).Assembly.GetManifestResourceStream(ResourceName)
                If oStream Is Nothing Then Exit Sub
                Using oReader As New IO.StreamReader(oStream)
                    While Not oReader.EndOfStream
                        ParseLine(oReader.ReadLine())
                    End While
                End Using
            End Using
            _ListAvailable = _IntelGenerations.Count > 0 AndAlso _AmdModels.Count > 0
        Catch ex As Exception
            Console.WriteLine("ProcessorSupport.EnsureLoaded: " + ex.Message)
        End Try
    End Sub

    Private Sub ParseLine(ByVal pLine As String)
        If String.IsNullOrWhiteSpace(pLine) OrElse pLine.StartsWith("#", StringComparison.Ordinal) Then Exit Sub

        Dim oFields() As String = pLine.Split(ControlChars.Tab)
        If oFields.Length < 3 Then Exit Sub

        If oFields(0) = "intel" Then
            ParseIntel(oFields(2))
        ElseIf oFields(0) = "amd" Then
            ParseAmd(oFields(1), oFields(2))
        End If
    End Sub

    ''' <summary>Series like "10th Generation Core i7 Processors", "Core i7 processors (14th Generation )", "Intel Core 7000X Series".</summary>
    Private Sub ParseIntel(ByVal pSeries As String)
        Dim oMatch As Match = Regex.Match(pSeries, "^(\d+)(?:st|nd|rd|th) Generation Core (i[3579]|m)\b", RegexOptions.IgnoreCase)
        If Not oMatch.Success Then oMatch = Regex.Match(pSeries, "^Core (i[3579]) processors \((\d+)(?:st|nd|rd|th) Generation", RegexOptions.IgnoreCase)

        If oMatch.Success Then
            Dim oNumberFirst As Boolean = Char.IsDigit(oMatch.Groups(1).Value(0))
            Dim oGeneration As Integer = Integer.Parse(If(oNumberFirst, oMatch.Groups(1).Value, oMatch.Groups(2).Value), CultureInfo.InvariantCulture)
            Dim oBrand As String = If(oNumberFirst, oMatch.Groups(2).Value, oMatch.Groups(1).Value).ToLowerInvariant()
            _IntelGenerations.Add(oGeneration.ToString(CultureInfo.InvariantCulture) + "|" + oBrand)
            If oGeneration > _NewestIntelGeneration Then _NewestIntelGeneration = oGeneration
            Exit Sub
        End If

        Dim oXSeries As Match = Regex.Match(pSeries, "Core (\d+)X Series", RegexOptions.IgnoreCase)
        If oXSeries.Success Then _IntelXSeries.Add(Integer.Parse(oXSeries.Groups(1).Value, CultureInfo.InvariantCulture))
    End Sub

    ''' <summary>Brand like "Ryzen 7 PRO", "Athlon", "EPYC"; model like "7700", "Silver 3050U", "3200G with Radeon Vega 8 Graphics".</summary>
    Private Sub ParseAmd(ByVal pBrand As String, ByVal pModel As String)
        Dim oBrand As String = pBrand.Trim().ToLowerInvariant()
        Dim oModel As String = pModel.ToLowerInvariant()
        oModel = Regex.Replace(oModel, "\(.*?\)", String.Empty)
        oModel = Regex.Replace(oModel, "\s+with\b.*$", String.Empty)
        oModel = Regex.Replace(oModel, "\s+microsoft surface.*$", String.Empty)
        oModel = Regex.Replace(oModel, "\s+processor$", String.Empty).Trim()
        If oModel.Length = 0 Then Exit Sub

        _AmdModels.Add(oBrand + "|" + oModel)
        Dim oSpace As Integer = oModel.LastIndexOf(" "c)
        If oSpace > 0 Then _AmdModels.Add(oBrand + "|" + oModel.Substring(oSpace + 1)) '"silver 3050u" is also found as "3050u"
    End Sub
#End Region
End Module
