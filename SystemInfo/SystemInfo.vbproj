<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CDE.SystemInfo</RootNamespace>
    <AssemblyName>SystemInfo</AssemblyName>
    <StartupObject>CDE.SystemInfo.modMain</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>

    <AssemblyTitle>SystemInfo</AssemblyTitle>
    <Product>SystemInfo</Product>
    <Company>CDE Consulting</Company>
    <Copyright>Copyright © 2010</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>SystemInfo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SystemInfo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Remote computer setup script, shown by frmRemoteSetup -->
    <EmbeddedResource Include="..\docs\enable-remote-wmi.ps1" LogicalName="enable-remote-wmi.ps1" />
    <!-- Microsoft list of processors supported by Windows 11, used by ProcessorSupport (see docs\update-supported-processors.ps1) -->
    <EmbeddedResource Include="Data\windows11-supported-processors.txt" LogicalName="windows11-supported-processors.txt" />
  </ItemGroup>

</Project>
